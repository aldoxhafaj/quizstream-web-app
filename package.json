  "type": "module",
  "scripts": {
    "_____________COMMON_____________": "echo 'You run a comment script'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --check \"**/*.ts\" \"**/*.tsx\" \"**/*.js\"",
    "prettify": "prettier --write \"**/*.ts\" \"**/*.tsx\" \"**/*.js\"",
    "ts:check": "tsc --project tsconfig.json --noEmit",
    "prepare": "husky",
    "_____________I18N_______________": "echo 'You run a comment script'",
    "messages:extract": "cmd /c \"src\\utils\\scripts\\i18n-extract.bat\"",
    "messages:compile": "cmd /c \"src\\utils\\scripts\\i18n-compile.bat\"",
    "___________STORYBOOK____________": "echo 'You run a comment script'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "_____________DEFAULT____________": "echo 'You run a comment script'",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
